# APK binaries are the store's payload, not source — keep them out of git.
repo/apks/*.apk
repo/icons/*

# Generated catalog (regenerate with tools/reindex).
repo/index.json

# Android build artifacts
client/.gradle/
client/.gradle-cache/
client/build/
client/app/build/
client/local.properties
client/.kotlin/

__pycache__/

# Changelog sidecars (repo/apks/*.json) are deliberately NOT ignored: they are
# the one thing tools/reindex cannot rebuild from the APK binaries.
