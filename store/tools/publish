#!/usr/bin/env python3
"""Publish an APK into the BAM Store repository.

    tools/publish path/to/app.apk [--changelog "What changed"]

Copies the APK to repo/apks/<package>-<versionCode>.apk, extracts its icon,
records an optional changelog sidecar, and regenerates both indexes: the
store's own index.json and the signed F-Droid index (see fdroidhook).
"""

from __future__ import annotations

import argparse
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fdroidhook
import storelib as S


def main() -> int:
    ap = argparse.ArgumentParser(description="Publish an APK into the repo.")
    ap.add_argument("apk", help="path to the APK to publish")
    ap.add_argument("--changelog", default=None, help="release notes for this version")
    args = ap.parse_args()

    if not os.path.isfile(args.apk):
        ap.error(f"no such file: {args.apk}")

    os.makedirs(S.APKS_DIR, exist_ok=True)

    # Read metadata first so we can name the stored file deterministically.
    tmp_meta = S.meta_for_apk(args.apk, args.changelog)
    dest = os.path.join(S.APKS_DIR, f"{tmp_meta.packageName}-{tmp_meta.versionCode}.apk")
    shutil.copyfile(args.apk, dest)

    if args.changelog:
        import json
        os.makedirs(S.SIDECARS_DIR, exist_ok=True)
        with open(S.sidecar_path(dest), "w") as f:
            json.dump({"changelog": args.changelog}, f, indent=2)

    apps = S.rebuild_index()
    published = next(a for a in apps if a.packageName == tmp_meta.packageName)
    print(f"published {published.label} {published.versionName} "
          f"(v{published.versionCode}, {published.size} bytes)")
    print(f"  apk:   {published.apk}")
    print(f"  icon:  {published.icon or '(none)'}")
    print(f"  index: {S.INDEX_PATH} — {len(apps)} app(s)")

    fdroidhook.update()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
