#!/usr/bin/env python3
"""Regenerate repo/index.json from the APKs currently in repo/apks/.

    tools/reindex

Useful after manually adding, replacing, or deleting APK files. Keeps only the
highest versionCode per package. The F-Droid index is regenerated too, so the
two stay consistent (see fdroidhook).
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fdroidhook
import storelib as S


def main() -> int:
    apps = S.rebuild_index()
    for a in sorted(apps, key=lambda a: a.label.lower()):
        print(f"  {a.label:24} v{a.versionName:10} (code {a.versionCode})")
    print(f"index: {S.INDEX_PATH} — {len(apps)} app(s)")

    fdroidhook.update()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
